#include <winver.h>
#include "Version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PS5FM_VERSION_MAJOR, PS5FM_VERSION_MINOR, PS5FM_VERSION_REVISION, PS5FM_VERSION_BUILD
PRODUCTVERSION PS5FM_VERSION_MAJOR, PS5FM_VERSION_MINOR, PS5FM_VERSION_REVISION, PS5FM_VERSION_BUILD
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "PS5 File Manager plugin for Far Manager 3"
      VALUE "FileVersion", PS5FM_VERSION_STRING
      VALUE "InternalName", "PS5FM"
      VALUE "OriginalFilename", "PS5FM.dll"
      VALUE "ProductName", "far-ps5-filemanager"
      VALUE "ProductVersion", PS5FM_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
